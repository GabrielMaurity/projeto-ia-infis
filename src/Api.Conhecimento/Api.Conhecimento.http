@Api.Conhecimento_HostAddress = http://localhost:5026

GET {{Api.Conhecimento_HostAddress}}/api/status
Accept: application/json

###

# Ajuste o caminho do PDF (máximo 2 MB).
POST {{Api.Conhecimento_HostAddress}}/api/v1/ingest
Accept: application/json
Content-Type: multipart/form-data; boundary=limite

--limite
Content-Disposition: form-data; name="NomeUsuario"

gabriel
--limite
Content-Disposition: form-data; name="CodigoDocumento"

DOC-RH-001
--limite
Content-Disposition: form-data; name="Validade"

2027-12-31
--limite
Content-Disposition: form-data; name="Arquivo"; filename="documento.pdf"
Content-Type: application/pdf

< ./Documentos/documento.pdf
--limite--

